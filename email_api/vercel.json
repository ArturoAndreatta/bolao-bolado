{
  "functions": {
    "api/redefinir-senha.js": {
      "maxDuration": 10
    },
    "api/enviar-codigo-login.js": {
      "maxDuration": 10
    },
    "api/entrar-com-codigo.js": {
      "maxDuration": 10
    },
    "api/manter-redis.js": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/manter-redis",
      "schedule": "0 9 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
