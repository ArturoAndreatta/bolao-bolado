rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Funções auxiliares ───────────────────────────────────────────────
    function estaLogado() {
      return request.auth != null;
    }

    function naoAnonimo() {
      return request.auth != null
             && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Lê o doc do usuário e retorna se ele é admin. Só chamar quando já se
    // sabe que request.auth != null (senão o path fica inválido).
    function temPermissaoAdmin() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    // ── Coleção de usuários ──────────────────────────────────────────────
    match /usuarios/{uid} {
      // Leitura aberta a qualquer sessão, anônima inclusive: nome e avatar
      // aparecem na lista de participantes e no chat antes do login. É
      // justamente por isso que este documento NÃO pode guardar nada
      // privado — ver perfilSemDadoPrivado() abaixo.
      allow read: if estaLogado();

      // `email` ficava aqui e, com a leitura aberta, qualquer visitante
      // baixava a lista de e-mails de todos os usuários. O e-mail já mora no
      // Firebase Auth; aqui ele não pode mais entrar. Doc antigo que ainda o
      // tem pode mantê-lo intacto ou removê-lo (é o que a limpeza do app
      // faz ao logar), nunca gravar um valor novo.
      function perfilSemDadoPrivado() {
        return !('email' in request.resource.data)
               || (resource != null
                   && request.resource.data.email == resource.data.get('email', null));
      }

      // Nome curto e não vazio: ele aparece em lista, chat e menção. Doc só
      // de avatar (sem `nome`) continua válido.
      function nomeValido() {
        let nome = request.resource.data.get('nome', 'x');
        return nome is string && nome.size() > 0 && nome.size() <= 60;
      }

      // kCorBaseAdmin (0xFF7400C7) é o que identifica o admin de relance no
      // chat e na lista. Um usuário comum gravando essa cor se passaria por
      // ele. O get() de temPermissaoAdmin() só roda quando a cor é a do
      // admin — no caso comum a comparação curta-circuita antes.
      function corPermitida() {
        return request.resource.data.get('avatarColor', 0) != 4285792455
               || temPermissaoAdmin();
      }

      // Criação do próprio documento: não pode nascer já como admin.
      allow create: if estaLogado()
                     && request.auth.uid == uid
                     && request.resource.data.get('isAdmin', false) == false
                     && perfilSemDadoPrivado()
                     && nomeValido()
                     && corPermitida();

      // Atualização: o próprio usuário pode editar seus dados, mas não pode
      // alterar seu próprio campo isAdmin (só via console/admin SDK).
      allow update: if estaLogado()
                     && request.auth.uid == uid
                     && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)
                     && perfilSemDadoPrivado()
                     && nomeValido()
                     && corPermitida();

      // Admin pode criar/editar doc de avatar de participante SIMULADO
      // (uid prefixado "sim-", ver kPrefixoUidSimulado em simulador_apostas.dart)
      // para dar cor/emoji às apostas fake do Painel ADM. Só isAdmin: false
      // e só avatarColor/avatarEmoji — nunca ganha campos de usuário real.
      allow create, update: if naoAnonimo() && temPermissaoAdmin()
                             && uid.matches('sim-.*')
                             && request.resource.data.keys().hasOnly(['avatarColor', 'avatarEmoji']);

      // Admin remove o doc de avatar junto ao limpar apostas simuladas.
      allow delete: if naoAnonimo() && temPermissaoAdmin() && uid.matches('sim-.*');
    }

    // ── Salas e subcoleções ──────────────────────────────────────────────
    match /Salas/{salaId} {
      // Qualquer pessoa autenticada pode ver a lista de salas (Consultar Salas)
      allow read: if estaLogado();

      // Criação de sala: usuário logado (não anônimo). Um usuário comum NUNCA
      // pode criar uma sala marcada como `principal: true` — esse campo decide
      // qual sala recebe as apostas e a chave PIX que recebe o dinheiro, então
      // sequestrá-lo permitiria desviar todos os pagamentos. Só admin pode
      // definir a sala principal (via console/admin SDK ou regra de update
      // abaixo, que já exige isAdmin).
      //
      // Criar sala também passou a ser só do admin. Aberto a qualquer conta,
      // qualquer um publicava uma sala com nome de oficial e a PRÓPRIA chave
      // PIX, listada em Consultar Salas lado a lado com a verdadeira — golpe
      // pronto, sem precisar tocar na sala principal. Quando existirem salas
      // de usuários de verdade, isso volta a abrir com alguma aprovação.
      //
      // `senha` não pode viver aqui: este documento é lido por qualquer
      // sessão, anônima inclusive. Ela fica em Privado/acesso (abaixo).
      allow create: if naoAnonimo()
                     && temPermissaoAdmin()
                     && request.resource.data.get('principal', false) == false
                     && !('senha' in request.resource.data);

      // Atualização: apenas admin (edição de sala pelo painel admin, e o
      // campo `configuracoes` — ritmo/estilo/aposta dupla do simulador,
      // ver services/configuracoes/configuracoes_service.dart).
      // `senha` pode sair (limpeza dos docs antigos) ou ficar como estava —
      // senão sala ainda não migrada travaria toda edição do painel —, mas
      // nunca receber valor novo.
      allow update: if naoAnonimo() && temPermissaoAdmin()
                     && (!('senha' in request.resource.data)
                         || request.resource.data.senha == resource.data.get('senha', null));

      allow delete: if false; // ajuste futuro: apenas o criador da sala

      // ── Dados privados da sala ─────────────────────────────────────────
      // Hoje só a senha de acesso (doc `acesso`). Separada do doc da sala
      // porque regra do Firestore libera ou nega o DOCUMENTO inteiro, não
      // campo a campo: no doc público, qualquer visitante lia a senha.
      match /Privado/{docId} {
        allow read, write: if naoAnonimo() && temPermissaoAdmin();
      }

      // ── Participantes (apostas) ────────────────────────────────────────
      match /Participantes/{uid} {
        // Leitura: qualquer autenticado pode ver a lista (tela Participantes)
        allow read: if estaLogado();

        // Teto por aposta configurado na sala (campo `valorMaximo`).
        //
        // Sala sem o campo, ou com valor <= 0, não tem limite — é como
        // valorMaximoDe() trata o caso no app, e um teto de zero só poderia
        // recusar toda e qualquer aposta.
        //
        // Os DOIS limites que dependem do documento da sala, resolvidos num
        // único get(): o teto por aposta (`valorMaximo`) e a quantidade de
        // jogos, que não pode passar das cotas efetivamente pagas.
        //
        // CUSTO: um get() no doc da sala, cobrado como leitura extra por
        // escrita de aposta. É aceito de propósito — sem ele o limite vive
        // só no cliente, e qualquer chamada direta pelo SDK grava acima do
        // teto, distorcendo o rateio do prêmio. Estar tudo na MESMA função
        // é o que evita pagar esse get() duas vezes.
        //
        // ATENÇÃO: o preço da cota está duplicado aqui e em
        // services/bet/preco_cota.dart. A linguagem de regras não importa
        // código, e sem o preço não há como converter `valor` em cotas. Ao
        // mudar um preço, mude os dois.
        //
        // O TETO DE JOGOS é exato, não arbitrário: todo jogo custa no mínimo
        // uma cota (o jogo simples), então nunca pode haver mais jogos do
        // que cotas. O teto absoluto de 500 (kMaximoJogosPorAposta em
        // jogos_aposta.dart) é o segundo trinco, para sala sem valorMaximo:
        // segura o documento longe do limite de 1 MiB do Firestore.
        //
        // O que a regra NÃO consegue checar: o conteúdo de cada jogo. Sem
        // iteração (não há list comprehension, lambda, min/max), não dá para
        // validar que cada elemento é um map com uma lista de inteiros na
        // faixa do sorteio, nem somar C(k,n) para conferir o custo real dos
        // jogos grandes. Isso fica com a UI (ver selecao_jogos_dialog.dart).
        // O estrago possível é pequeno: jogo inválido gravado por fora não
        // rende cota nenhuma a mais — cota vem de `valor`, que é checado
        // aqui —, só produziria um jogo que o organizador não compraria.
        function apostaCabeNaSala() {
          let sala = get(/databases/$(database)/documents/Salas/$(salaId)).data;
          let maximo = sala.get('valorMaximo', 0);
          let sorteio = sala.get('sorteio', '');
          let precoCota = (sorteio == 'lotofacil' || sorteio == 'loto') ? 3.5 : 6.0;
          // `valor` é string por invariante; float() converte para comparar.
          let valor = float(request.resource.data.valor);
          let jogos = request.resource.data.get('jogos', []);
          return (maximo <= 0 || valor <= maximo)
                 && jogos is list
                 && jogos.size() <= 500
                 && jogos.size() <= valor / precoCota;
        }

        // Campo legado `numeros`: o jogo único que a aposta guardava solto na
        // raiz do doc antes de existirem vários jogos. O app não grava mais
        // isso (só lê, ver jogosDeDados), mas um cliente com a versão antiga
        // ainda em cache pode gravar durante a janela do deploy — então a
        // validação de então continua valendo enquanto o campo for aceito.
        function numerosValidos() {
          let numeros = request.resource.data.get('numeros', []);
          return numeros is list
                 && numeros.size() <= 25
                 && numeros.toSet().size() == numeros.size();
        }

        // Formato do doc que o próprio participante pode gravar. Sem
        // `hasOnly`, dava para pendurar qualquer campo na aposta (inclusive
        // `criadoPeloAdmin`, que o painel usa para distinguir aposta manual).
        // `data-hora` precisa ser a hora do servidor: é ela que ordena a
        // lista, e uma data inventada furava a fila.
        function formatoApostaValido() {
          let dados = request.resource.data;
          return dados.keys().hasOnly(['nome', 'valor', 'uid', 'data-hora', 'verificado',
                                       'editadoAposVerificacao', 'jogos', 'numeros'])
                 && dados.get('uid', uid) == uid
                 && dados.nome is string
                 && dados.nome.size() > 0
                 && dados.nome.size() <= 60
                 && dados['data-hora'] == request.time;
        }

        // Criação da PRÓPRIA aposta: o usuário comum não pode nascer
        // `verificado: true` — essa flag define quem entra no rateio do
        // prêmio, e só o admin pode aprová-la. Sem isso, qualquer um poderia
        // se auto-verificar com um valor gigante e sacar prêmio indevido.
        // `valor` é sempre salvo como string pelo app (ver minha_aposta_card).
        allow create: if naoAnonimo()
                       && request.auth.uid == uid
                       && request.resource.data.get('verificado', false) == false
                       && request.resource.data.valor is string
                       && apostaCabeNaSala()
                       && numerosValidos()
                       && formatoApostaValido();

        // Edição da PRÓPRIA aposta. Além de não poder se auto-verificar, o
        // usuário não pode apagar o rastro de uma edição feita DEPOIS da
        // aprovação: se a aposta já estava verificada, o update é obrigado a
        // deixá-la pendente E marcada como `editadoAposVerificacao: true`,
        // que é o sinal que faz o admin revisar de novo.
        //
        // Antes isso dependia do cliente cooperar: um `update` direto pelo
        // SDK podia mudar `valor` mandando só `verificado: false`, saindo do
        // rateio-aprovado sem deixar nenhuma marca de que o valor mudou
        // depois de aprovado.
        allow update: if naoAnonimo()
                       && request.auth.uid == uid
                       && request.resource.data.get('verificado', false) == false
                       && request.resource.data.valor is string
                       && apostaCabeNaSala()
                       && numerosValidos()
                       && formatoApostaValido()
                       && (
                            resource.data.get('verificado', false) == false
                            || request.resource.data.get('editadoAposVerificacao', false) == true
                          )
                       // A marca, uma vez posta, só sai pela mão do admin
                       // (ao aprovar de novo). Sem isto, uma segunda edição
                       // regravava `false` e a aposta voltava a parecer nova
                       // para quem confere, apagando o rastro da primeira.
                       && (
                            resource.data.get('editadoAposVerificacao', false) == false
                            || request.resource.data.get('editadoAposVerificacao', false) == true
                          );

        // Apagar a própria aposta não é permitido: sair do bolão depois de
        // ter pago é decisão de admin (o dinheiro já entrou no rateio).
        // Isto já valia na prática — a regra anterior usava `allow write`,
        // que cobre delete, e a checagem de `request.resource` (nulo em
        // delete) reprovava. Agora é explícito em vez de acidental.
        allow delete: if false;

        // Escrita do ADMIN em qualquer participante: aprovar (verificado),
        // lançar aposta manual em nome de terceiros, remover aposta.
        // `valor is string` vale para o admin também: é a invariante que o
        // resto do app assume ao ler (o parse pra número acontece na
        // leitura), e gravar num aqui quebraria o cálculo de cotas.
        //
        // O admin NÃO passa por apostaCabeNaSala(): quem define o teto é
        // ele próprio, e lançar uma aposta acima do limite (alguém que pagou
        // mais por fora, correção pontual) é caso de uso legítimo do painel.
        // O painel valida o teto na UI; aqui a regra não impede. Isso também
        // poupa o get() extra da sala nas escritas do admin, que são as mais
        // frequentes durante a conferência das apostas.
        allow create, update: if naoAnonimo()
                               && temPermissaoAdmin()
                               && request.resource.data.valor is string;
        allow delete: if naoAnonimo() && temPermissaoAdmin();
      }

      // ── Mensagens do chat ───────────────────────────────────────────────
      match /Mensagens/{mensagemId} {
        // Leitura: qualquer usuário autenticado (mesmo anônimo) pode LER
        allow read: if estaLogado();

        function ehParticipante() {
          return exists(/databases/$(database)/documents/Salas/$(salaId)/Participantes/$(request.auth.uid));
        }

        // A reação é qualquer emoji, e não mais uma lista fechada de seis —
        // ver o cabeçalho de services/chat/emoji_reacao.dart para o porquê da
        // troca. O que sobrou aqui é o formato, que é tudo que esta linguagem
        // consegue checar: ela não itera runes nem sabe o que é um emoji.
        //
        // O critério é "curta e sem nenhum ASCII". Sem ASCII derruba texto
        // latino inteiro, que é o abuso que importa: a reação não pode virar
        // um segundo canal de recado sem moderação. O teto de tamanho é o que
        // impede o campo de crescer — 32 aceita a maior sequência legítima
        // (família com ZWJ e tom de pele) com folga.
        //
        // O CLIENTE é mais restrito: ehEmojiReacao() exige que cada rune caia
        // numa faixa de emoji. Passar aqui e não lá é possível (alfabeto não
        // latino escrito direto no Firestore); o contrário, não — e é essa
        // direção que mantém o app funcionando.
        function ehReacaoValida(emoji) {
          return emoji is string
                 && emoji.size() <= 32
                 && emoji.matches('[^\\x00-\\x7F]+');
        }

        // Escrita: só quem está logado (não anônimo) E tem doc em Participantes
        //
        // `mencoes` é opcional e limitado a 10 (kMaximoMencoes): sem teto, uma
        // mensagem podia marcar a sala inteira de uma vez. A regra NÃO valida
        // o conteúdo de cada menção — não itera lista, mesma limitação de
        // `jogos` na aposta —, então uid e posições ficam por conta da UI. O
        // estrago possível é cosmético: menção torta acende o pedaço errado do
        // texto de quem a escreveu, e nada mais.
        //
        // `criadoEm` é obrigatoriamente a hora do servidor (a ordem do chat
        // sai dele: data inventada punha a mensagem fora de lugar) e os
        // campos são só os que o app grava. `autorNome` é texto livre porque
        // o nome do perfil também é — o que a regra garante é o tamanho.
        allow create: if naoAnonimo()
                       && request.auth.uid == request.resource.data.autorUid
                       && request.resource.data.keys().hasOnly(['texto', 'autorUid', 'autorNome', 'criadoEm', 'mencoes'])
                       && request.resource.data.criadoEm == request.time
                       && request.resource.data.autorNome is string
                       && request.resource.data.autorNome.size() > 0
                       && request.resource.data.autorNome.size() <= 60
                       && request.resource.data.texto is string
                       && request.resource.data.texto.size() > 0
                       && request.resource.data.texto.size() <= 200
                       && request.resource.data.get('mencoes', []) is list
                       && request.resource.data.get('mencoes', []).size() <= 10
                       && ehParticipante();

        // O TEXTO de uma mensagem publicada continua imutável: reescrevê-lo
        // colocaria palavras na boca do autor. O único update permitido é a
        // própria reação de quem está logado, dentro do mapa `reacoes` —
        // `hasOnly` garante nas duas camadas (campos do doc e chaves do mapa)
        // que nada mais é tocado, nem a reação de outra pessoa.
        //
        // Reação vive num campo do doc, e não em subcoleção, para chegar junto
        // com a mensagem na stream do chat (ver o doc de Mensagem.reacoes).
        // O default '👍' no get existe para o caso de REMOVER a reação: aí a
        // chave some, e sem um default válido a comparação reprovaria a
        // própria remoção.
        allow update: if naoAnonimo()
                       && ehParticipante()
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reacoes'])
                       && request.resource.data.get('reacoes', {}).diff(resource.data.get('reacoes', {})).affectedKeys().hasOnly([request.auth.uid])
                       && ehReacaoValida(request.resource.data.get('reacoes', {}).get(request.auth.uid, '👍'));

        // Apagar é permitido só ao admin (moderação do chat pelo painel).
        // O autor não pode apagar a própria mensagem — do contrário daria
        // pra falar algo no chat e apagar antes de alguém cobrar.
        allow delete: if naoAnonimo() && temPermissaoAdmin();
      }
    }

    // Regra explícita para collection group queries (ex: painel admin
    // listando apostas pendentes de TODAS as salas de uma vez via
    // collectionGroup('Participantes')). A regra aninhada em
    // Salas/{salaId}/Participantes/{uid} cobre leitura de uma sala por vez,
    // mas não é aplicada a queries de collection group — precisa desta
    // declaração own no nível raiz.
    match /{path=**}/Participantes/{uid} {
      allow read: if estaLogado();
    }
  }
}
