rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Funções auxiliares ───────────────────────────────────────────────
    function estaLogado() {
      return request.auth != null;
    }

    function naoAnonimo() {
      return request.auth != null
             && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Lê o doc do usuário e retorna se ele é admin. Só chamar quando já se
    // sabe que request.auth != null (senão o path fica inválido).
    function ehAdmin() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    // ── Coleção de usuários ──────────────────────────────────────────────
    match /usuarios/{uid} {
      allow read: if estaLogado();

      // Criação do próprio documento: não pode nascer já como admin.
      allow create: if estaLogado()
                     && request.auth.uid == uid
                     && request.resource.data.get('isAdmin', false) == false;

      // Atualização: o próprio usuário pode editar seus dados, mas não pode
      // alterar seu próprio campo isAdmin (só via console/admin SDK).
      allow update: if estaLogado()
                     && request.auth.uid == uid
                     && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false);

      allow delete: if false;
    }

    // ── Salas e subcoleções ──────────────────────────────────────────────
    match /Salas/{salaId} {
      // Qualquer pessoa autenticada pode ver a lista de salas (Consultar Salas)
      allow read: if estaLogado();

      // Criação de sala: usuário logado (não anônimo). Um usuário comum NUNCA
      // pode criar uma sala marcada como `principal: true` — esse campo decide
      // qual sala recebe as apostas e a chave PIX que recebe o dinheiro, então
      // sequestrá-lo permitiria desviar todos os pagamentos. Só admin pode
      // definir a sala principal (via console/admin SDK ou regra de update
      // abaixo, que já exige isAdmin).
      allow create: if naoAnonimo()
                     && request.resource.data.get('principal', false) == false;

      // Atualização: apenas admin (edição de sala pelo painel admin).
      allow update: if naoAnonimo() && ehAdmin();

      allow delete: if false; // ajuste futuro: apenas o criador da sala

      // ── Participantes (apostas) ────────────────────────────────────────
      match /Participantes/{uid} {
        // Leitura: qualquer autenticado pode ver a lista (tela Participantes)
        allow read: if estaLogado();

        // Teto por aposta configurado na sala (campo `valorMaximo`).
        //
        // Sala sem o campo, ou com valor <= 0, não tem limite — é como
        // valorMaximoDe() trata o caso no app, e um teto de zero só poderia
        // recusar toda e qualquer aposta.
        //
        // CUSTO: esta função faz um get() no doc da sala, cobrado como uma
        // leitura extra por escrita de aposta. É aceito de propósito — sem
        // ela o limite vive só no cliente, e qualquer chamada direta pelo SDK
        // grava acima do teto, distorcendo o rateio do prêmio.
        function respeitaValorMaximo() {
          let sala = get(/databases/$(database)/documents/Salas/$(salaId)).data;
          let maximo = sala.get('valorMaximo', 0);
          // `valor` é string por invariante; float() converte para comparar.
          return maximo <= 0
                 || float(request.resource.data.valor) <= maximo;
        }

        // Criação da PRÓPRIA aposta: o usuário comum não pode nascer
        // `verificado: true` — essa flag define quem entra no rateio do
        // prêmio, e só o admin pode aprová-la. Sem isso, qualquer um poderia
        // se auto-verificar com um valor gigante e sacar prêmio indevido.
        // `valor` é sempre salvo como string pelo app (ver minha_aposta_card).
        allow create: if naoAnonimo()
                       && request.auth.uid == uid
                       && request.resource.data.get('verificado', false) == false
                       && request.resource.data.valor is string
                       && respeitaValorMaximo();

        // Edição da PRÓPRIA aposta. Além de não poder se auto-verificar, o
        // usuário não pode apagar o rastro de uma edição feita DEPOIS da
        // aprovação: se a aposta já estava verificada, o update é obrigado a
        // deixá-la pendente E marcada como `editadoAposVerificacao: true`,
        // que é o sinal que faz o admin revisar de novo.
        //
        // Antes isso dependia do cliente cooperar: um `update` direto pelo
        // SDK podia mudar `valor` mandando só `verificado: false`, saindo do
        // rateio-aprovado sem deixar nenhuma marca de que o valor mudou
        // depois de aprovado.
        allow update: if naoAnonimo()
                       && request.auth.uid == uid
                       && request.resource.data.get('verificado', false) == false
                       && request.resource.data.valor is string
                       && respeitaValorMaximo()
                       && (
                            resource.data.get('verificado', false) == false
                            || request.resource.data.get('editadoAposVerificacao', false) == true
                          );

        // Apagar a própria aposta não é permitido: sair do bolão depois de
        // ter pago é decisão de admin (o dinheiro já entrou no rateio).
        // Isto já valia na prática — a regra anterior usava `allow write`,
        // que cobre delete, e a checagem de `request.resource` (nulo em
        // delete) reprovava. Agora é explícito em vez de acidental.
        allow delete: if false;

        // Escrita do ADMIN em qualquer participante: aprovar (verificado),
        // lançar aposta manual em nome de terceiros, remover aposta.
        // `valor is string` vale para o admin também: é a invariante que o
        // resto do app assume ao ler (o parse pra número acontece na
        // leitura), e gravar num aqui quebraria o cálculo de cotas.
        //
        // O admin NÃO passa por respeitaValorMaximo(): quem define o teto é
        // ele próprio, e lançar uma aposta acima do limite (alguém que pagou
        // mais por fora, correção pontual) é caso de uso legítimo do painel.
        // O painel valida o teto na UI; aqui a regra não impede. Isso também
        // poupa o get() extra da sala nas escritas do admin, que são as mais
        // frequentes durante a conferência das apostas.
        allow create, update: if naoAnonimo()
                               && ehAdmin()
                               && request.resource.data.valor is string;
        allow delete: if naoAnonimo() && ehAdmin();
      }

      // ── Mensagens do chat ───────────────────────────────────────────────
      match /Mensagens/{mensagemId} {
        // Leitura: qualquer usuário autenticado (mesmo anônimo) pode LER
        allow read: if estaLogado();

        // Escrita: só quem está logado (não anônimo) E tem doc em Participantes
        allow create: if naoAnonimo()
                       && request.auth.uid == request.resource.data.autorUid
                       && request.resource.data.texto is string
                       && request.resource.data.texto.size() > 0
                       && request.resource.data.texto.size() <= 200
                       && exists(/databases/$(database)/documents/Salas/$(salaId)/Participantes/$(request.auth.uid));

        // Mensagens nunca podem ser EDITADAS: reescrever o texto de uma
        // mensagem já publicada colocaria palavras na boca do autor.
        allow update: if false;

        // Apagar é permitido só ao admin (moderação do chat pelo painel).
        // O autor não pode apagar a própria mensagem — do contrário daria
        // pra falar algo no chat e apagar antes de alguém cobrar.
        allow delete: if naoAnonimo() && ehAdmin();
      }
    }

    // Regra explícita para collection group queries (ex: painel admin
    // listando apostas pendentes de TODAS as salas de uma vez via
    // collectionGroup('Participantes')). A regra aninhada em
    // Salas/{salaId}/Participantes/{uid} cobre leitura de uma sala por vez,
    // mas não é aplicada a queries de collection group — precisa desta
    // declaração own no nível raiz.
    match /{path=**}/Participantes/{uid} {
      allow read: if estaLogado();
    }
  }
}
